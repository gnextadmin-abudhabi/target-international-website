---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogUrl } from '../../lib/urls';
import { business } from '../../data/business';
import { Icon } from 'astro-icon/components';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

function formatDate(iso: string): string {
  const date = new Date(iso + 'T00:00:00');
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title={`MEP Insights | ${business.name}`}
  description={`MEP tips, maintenance guides, and industry news from ${business.name}. Expert advice for building owners in Abu Dhabi.`}
>
  <Breadcrumbs crumbs={[{ label: 'Insights' }]} />

  <section class="relative bg-white pt-32 pb-20 lg:pb-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Insights</span>
      <h1 class="mt-6 max-w-3xl font-display text-5xl text-navy-900 sm:text-6xl lg:text-7xl leading-[0.95]">
        MEP Tips & News
      </h1>
      <p class="mt-8 max-w-2xl text-base leading-relaxed text-navy-500">
        Practical advice, maintenance guides, and industry insights from the team at {business.name}.
      </p>
    </div>
  </section>

  <section class="bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-center text-navy-400">No posts yet. Check back soon.</p>
      ) : (
        <div class="grid gap-px bg-navy-200 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={blogUrl(post.id)}
              class="group bg-white p-8 transition-colors hover:bg-surface reveal stagger-1"
            >
              <div class="flex items-center gap-3">
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold-600">{post.data.category}</span>
                {post.data.readingTime && (
                  <span class="flex items-center gap-1 text-[10px] text-navy-400">
                    <Icon name="lucide:clock" class="h-3 w-3" />
                    {post.data.readingTime}
                  </span>
                )}
              </div>
              <h2 class="mt-4 font-display text-xl text-navy-900 transition-colors group-hover:text-gold-600">{post.data.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-navy-500 line-clamp-3">{post.data.description}</p>
              <div class="mt-6 flex items-center gap-2 text-xs text-navy-400">
                <Icon name="lucide:calendar" class="h-3 w-3" />
                <time datetime={post.data.publishDate}>{formatDate(post.data.publishDate)}</time>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
