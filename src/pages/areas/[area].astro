---
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceAreas, getAreaBySlug, getNearbyAreas } from '../../data/serviceAreas';
import { comboUrl, areaUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';
import SeoTestimonials from '../../components/SeoTestimonials.astro';

import type { ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
const nearbyAreas = getNearbyAreas(area);

const pageTitle = `MEP Contractor in ${area.name}, UAE`;
const metaDescription = `Licensed MEP contractor serving ${area.name}, ${area.county}. ${area.responseTime} response. Residential and commercial HVAC, electrical, plumbing. Call ${business.phone}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: business.name,
  description: `${business.name} provides licensed MEP contracting services in ${area.name}, ${area.county}, UAE.`,
  telephone: business.phone,
  url: business.website,
  address: {
    '@type': 'PostalAddress',
    addressLocality: area.name,
    addressRegion: 'Abu Dhabi',
    postalCode: area.zipCodes[0],
    addressCountry: 'AE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: area.lat,
    longitude: area.lng,
  },
  areaServed: [
    { '@type': 'City', name: area.name },
    { '@type': 'AdministrativeArea', name: area.county },
  ],
  openingHoursSpecification: business.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.hours === 'Closed' ? undefined : '08:00',
    closes: h.hours === 'Closed' ? undefined : '18:00',
  })),

};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <Breadcrumbs crumbs={[{ label: 'Areas', href: '/areas/' }, { label: area.name }]} />

  <section class="bg-white pt-32 pb-20 lg:pb-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <span class="section-label">{area.county}</span>
          <h1 class="mt-6 font-display text-4xl text-navy-900 sm:text-5xl lg:text-6xl leading-[0.95]">{pageTitle}</h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-navy-600">{area.description}</p>
          <p class="mt-4 text-navy-600">
            {business.name} has served {area.name} for over {yearsInBusiness()} years. Whether you need emergency HVAC repair or a complete MEP design, our licensed team delivers reliable, professional work.
          </p>
        </div>
        <div class="lg:col-span-1">
          <div class="border border-navy-200 bg-surface p-6">
            <h2 class="text-[10px] font-bold uppercase tracking-[0.2em] text-navy-500">Quick Facts</h2>
            <dl class="mt-4 space-y-4">
              <div>
                <dt class="text-[10px] font-bold uppercase tracking-wider text-navy-400">Region</dt>
                <dd class="mt-1 text-sm font-bold text-navy-900">{area.county}</dd>
              </div>
              <div>
                <dt class="text-[10px] font-bold uppercase tracking-wider text-navy-400">Population</dt>
                <dd class="mt-1 text-sm font-bold text-navy-900">{area.population.toLocaleString()}</dd>
              </div>
              <div>
                <dt class="text-[10px] font-bold uppercase tracking-wider text-navy-400">Response</dt>
                <dd class="mt-1 flex items-center gap-2 text-sm font-bold text-gold-600">
                  <Icon name="lucide:clock" class="h-4 w-4" />
                  {area.responseTime}
                </dd>
              </div>
            </dl>
            <a href={business.phoneHref} class="btn-primary mt-6 flex w-full items-center justify-center">
              <Icon name="lucide:phone" class="h-4 w-4" />
              {business.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Services</span>
      <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Services in {area.name}</h2>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceTypes.map((service) => (
          <a href={comboUrl(area.slug, service.slug)} class="group border border-navy-200 bg-white p-6 transition-all hover:border-gold-400 hover:bg-surface">
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center border border-navy-200 text-navy-600 transition-colors group-hover:border-gold-400 group-hover:text-gold-600">
                <Icon name={service.icon} class="h-4 w-4" />
              </div>
              {service.emergency && (
                <span class="text-[10px] font-bold uppercase tracking-wider text-red-600">Emergency</span>
              )}
            </div>
            <h3 class="mt-4 text-sm font-bold text-navy-900 transition-colors group-hover:text-navy-800">{service.name}</h3>
            <p class="mt-2 text-xs text-navy-500 line-clamp-2">{service.shortDescription}</p>
            <p class="mt-3 text-xs font-bold uppercase tracking-wider text-gold-600">
              {service.emergency ? '24/7 Emergency' : 'Get a Free Estimate'}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {nearbyAreas.length > 0 && (
    <section class="bg-white py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <span class="section-label">Nearby</span>
        <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Areas Near {area.name}</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {nearbyAreas.map((nearby) => (
            <a href={areaUrl(nearby.slug)} class="group border border-navy-200 bg-white p-6 transition-all hover:border-gold-400 hover:bg-surface">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center border border-navy-200 text-navy-400 transition-colors group-hover:border-gold-400 group-hover:text-gold-600">
                  <Icon name="lucide:map-pin" class="h-3.5 w-3.5" />
                </div>
                <span class="text-sm font-bold text-navy-900 transition-colors group-hover:text-navy-800">{nearby.name}</span>
              </div>
              <p class="mt-2 text-xs text-navy-400">{nearby.county}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <SeoFaq area={area} />

  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
      <SeoTestimonials area={area} />
    </div>
  </div>

  <section class="bg-navy-900 py-24 lg:py-32">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-4xl text-white sm:text-5xl leading-[0.95]">Need an MEP Contractor in {area.name}?</h2>
      <p class="mx-auto mt-6 max-w-xl text-sm text-navy-300">{business.name} is locally licensed ({business.license}). Call us today.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={business.phoneHref} class="btn-gold"><Icon name="lucide:phone" class="h-4 w-4" />{business.phone}</a>
        <a href={contactUrl()} class="btn-outline border-white text-white hover:bg-white hover:text-navy-900">Request a Quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
