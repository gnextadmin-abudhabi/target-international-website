---
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { serviceTypes, getServiceBySlug } from '../../data/serviceTypes';
import { serviceAreas, getAreaBySlug } from '../../data/serviceAreas';
import { serviceUrl, comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';

import type { ServiceType } from '../../data/serviceTypes';

export function getStaticPaths() {
  return serviceTypes.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceType;
}

const { service } = Astro.props;
const primaryArea = getAreaBySlug('abu-dhabi')!;

const pageTitle = `${service.name} in Abu Dhabi & Western Region`;
const metaDescription = service.description.length > 155 ? service.description.slice(0, 152) + '...' : service.description;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: {
    '@type': 'GeneralContractor',
    name: business.name,
    telephone: business.phone,
    url: business.website,
    address: {
      '@type': 'PostalAddress',
      addressLocality: business.address.city,
      addressRegion: business.address.state,
      postalCode: business.address.zip,
      addressCountry: 'AE',
    },
  },
  areaServed: serviceAreas.map((area) => ({
    '@type': 'City',
    name: area.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: area.county },
  })),
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <Breadcrumbs crumbs={[{ label: 'Services', href: '/services/' }, { label: service.name }]} />

  <section class="bg-white pt-32 pb-20 lg:pb-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-end">
        <div>
          {service.emergency && (
            <div class="mb-6 inline-flex items-center gap-2 border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-red-600">
              <Icon name="lucide:alert-circle" class="h-3.5 w-3.5" />
              24/7 Emergency Available
            </div>
          )}
          <span class="section-label">{service.shortName}</span>
          <h1 class="mt-6 font-display text-4xl text-navy-900 sm:text-5xl lg:text-6xl leading-[0.95]">{pageTitle}</h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-navy-600">{service.description}</p>
        </div>
        <div class="hidden lg:block">
          <img src={service.image} alt={service.name} class="aspect-[4/3] w-full object-cover border border-navy-100" width="1024" height="768" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Key Stats -->
  <section class="bg-navy-900 py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {service.keyStats.map((stat) => (
          <div class="border border-navy-700 bg-navy-800 p-6 text-center">
            <span class="font-display text-4xl text-gold-500">{stat.value}</span>
            <p class="mt-2 text-sm font-medium text-navy-300">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detailed Description -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <span class="section-label">Overview</span>
          <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Comprehensive {service.shortName} Solutions</h2>
          <div class="mt-8 prose-editorial">
            {service.detailedDescription.split('\n\n').map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
        <div class="space-y-6">
          <div class="border border-navy-200 bg-white p-6">
            <h3 class="font-display text-lg text-navy-900">Response Time</h3>
            <div class="mt-4 space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-navy-600">Abu Dhabi</span>
                <span class="font-bold text-navy-900">30-45 min</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-navy-600">Western Region</span>
                <span class="font-bold text-navy-900">60-90 min</span>
              </div>
            </div>
          </div>
          {service.emergency && (
            <div class="border border-red-200 bg-red-50 p-6">
              <div class="flex items-center gap-2 text-red-700">
                <Icon name="lucide:zap" class="h-5 w-5" />
                <span class="text-sm font-bold">24/7 Emergency Service</span>
              </div>
              <p class="mt-2 text-xs text-red-600">Call {business.phone} any time for priority dispatch.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Benefits</span>
      <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Why Choose Our {service.shortName} Service?</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {service.benefits.map((benefit, index) => (
          <div class="border border-navy-200 bg-white p-8 reveal stagger-1">
            <div class="flex h-10 w-10 items-center justify-center bg-navy-800 text-white">
              <span class="font-display text-lg">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-4 font-display text-lg text-navy-900">{benefit.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-600">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries & Equipment -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <span class="section-label">Industries</span>
          <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Industries We Serve</h2>
          <p class="mt-4 text-sm text-navy-500">Our {service.shortName.toLowerCase()} expertise spans multiple sectors across Abu Dhabi and the Western Region.</p>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {service.industriesServed.map((industry) => (
              <div class="flex items-center gap-3 border border-navy-200 bg-surface p-4">
                <Icon name="lucide:building-2" class="h-4 w-4 text-gold-600" />
                <span class="text-sm font-medium text-navy-800">{industry}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <span class="section-label">Equipment</span>
          <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Equipment & Technology</h2>
          <p class="mt-4 text-sm text-navy-500">We use industry-leading equipment and technology to deliver superior results.</p>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {service.equipmentUsed.map((equipment) => (
              <div class="flex items-center gap-3 border border-navy-200 bg-surface p-4">
                <Icon name="lucide:wrench" class="h-4 w-4 text-gold-600" />
                <span class="text-sm font-medium text-navy-800">{equipment}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Standards -->
  <section class="bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Compliance</span>
      <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Standards & Certifications</h2>
      <p class="mt-4 max-w-2xl text-sm text-navy-500">Every project complies with international standards, UAE regulations, and manufacturer specifications.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {service.standardsCompliance.map((standard) => (
          <div class="flex items-start gap-3 border border-navy-200 bg-white p-5">
            <Icon name="lucide:shield-check" class="mt-0.5 h-4 w-4 shrink-0 text-gold-600" />
            <span class="text-xs font-medium leading-relaxed text-navy-700">{standard}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Project Examples -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Projects</span>
      <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Recent {service.shortName} Projects</h2>
      <p class="mt-4 max-w-2xl text-sm text-navy-500">A selection of projects that demonstrate our capabilities and experience.</p>
      <div class="mt-10 space-y-4">
        {service.projectExamples.map((project, index) => (
          <div class="flex items-start gap-4 border border-navy-200 bg-surface p-6 reveal stagger-1">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center bg-navy-800 text-white">
              <span class="text-xs font-bold">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <p class="text-sm leading-relaxed text-navy-700">{project}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Process -->
  <section class="bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Our Process</span>
      <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">How We Deliver {service.shortName}</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {service.processSteps.map((step, index) => (
          <div class="border border-navy-200 bg-white p-8 reveal stagger-1">
            <span class="font-display text-5xl text-navy-300">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 font-display text-lg text-navy-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-600">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Coverage</span>
      <h2 class="mt-6 font-display text-3xl text-navy-900 sm:text-4xl">Areas We Serve for {service.shortName}</h2>
      <p class="mt-4 max-w-xl text-sm text-navy-500">Select your area for local availability and response times.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceAreas.map((area) => (
          <a href={comboUrl(area.slug, service.slug)} class="group border border-navy-200 bg-white p-6 transition-all hover:border-gold-400 hover:bg-surface">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold text-navy-800 transition-colors group-hover:text-navy-900">{area.name}</span>
              <Icon name="lucide:arrow-right" class="h-4 w-4 -rotate-45 text-navy-400 transition-all group-hover:rotate-0 group-hover:text-gold-600" />
            </div>
            <p class="mt-1 text-xs text-navy-400">{area.county}</p>
            <p class="mt-2 text-xs font-bold uppercase tracking-wider text-gold-600">{area.responseTime} response</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SeoFaq area={primaryArea} service={service} />

  <section class="bg-navy-900 py-24 lg:py-32">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-4xl text-white sm:text-5xl leading-[0.95]">Need {service.shortName}?</h2>
      <p class="mx-auto mt-6 max-w-xl text-sm text-navy-300">{business.name} has been serving Abu Dhabi for over {yearsInBusiness()} years. Call us today for a free estimate.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={business.phoneHref} class="btn-gold"><Icon name="lucide:phone" class="h-4 w-4" />{business.phone}</a>
        <a href={contactUrl()} class="btn-outline border-white text-white hover:bg-white hover:text-navy-900">Request a Quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
