---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
---

<BaseLayout
  title={`Contact Us | ${business.name}`}
  description={`Get in touch with ${business.name} for a free MEP estimate. Call ${business.phone} or fill out our contact form. Serving ${business.serviceRadius}.`}
>
  <Breadcrumbs crumbs={[{ label: 'Contact' }]} />

  <!-- Hero -->
  <section class="relative bg-white pt-32 pb-20 lg:pb-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Get In Touch</span>
      <h1 class="mt-6 max-w-3xl font-display text-5xl text-navy-900 sm:text-6xl lg:text-7xl leading-[0.95]">
        Contact {business.name}
      </h1>
      <p class="mt-8 max-w-2xl text-base leading-relaxed text-navy-500">
        Have an MEP project or need maintenance support? Reach out by phone, email, or use the form below. We typically respond within one business day.
      </p>
    </div>
  </section>

  <!-- Form + Info -->
  <section class="bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-16 lg:grid-cols-12">
        <!-- Form -->
        <div class="lg:col-span-7 reveal">
          <div class="border border-navy-200 bg-white p-8 lg:p-10">
            <h2 class="font-display text-2xl text-navy-900">Send Us a Message</h2>
            <p class="mt-2 text-sm text-navy-400">Fill out the form and we will get back to you as soon as possible.</p>

            <form action="#" method="POST" class="mt-8 space-y-6">
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Full Name <span class="text-gold-600">*</span></label>
                  <input type="text" name="name" required class="mt-2 w-full border-b border-navy-200 bg-transparent py-2.5 text-sm text-navy-800 outline-none transition-colors focus:border-gold-500" />
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Email <span class="text-gold-600">*</span></label>
                  <input type="email" name="email" required class="mt-2 w-full border-b border-navy-200 bg-transparent py-2.5 text-sm text-navy-800 outline-none transition-colors focus:border-gold-500" />
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Phone</label>
                <input type="tel" name="phone" class="mt-2 w-full border-b border-navy-200 bg-transparent py-2.5 text-sm text-navy-800 outline-none transition-colors focus:border-gold-500" />
              </div>
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Service</label>
                  <select name="service" class="mt-2 w-full border-b border-navy-200 bg-transparent py-2.5 text-sm text-navy-800 outline-none transition-colors focus:border-gold-500">
                    <option value="">Select a service</option>
                    {serviceTypes.map((s) => <option value={s.slug}>{s.name}</option>)}
                  </select>
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Your Area</label>
                  <select name="area" class="mt-2 w-full border-b border-navy-200 bg-transparent py-2.5 text-sm text-navy-800 outline-none transition-colors focus:border-gold-500">
                    <option value="">Select area</option>
                    {serviceAreas.map((a) => <option value={a.slug}>{a.name}</option>)}
                  </select>
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Message <span class="text-gold-600">*</span></label>
                <textarea name="message" required rows="4" class="mt-2 w-full border-b border-navy-200 bg-transparent py-2.5 text-sm text-navy-800 outline-none transition-colors focus:border-gold-500 resize-y"></textarea>
              </div>
              <button type="submit" class="btn-primary">
                <Icon name="lucide:send" class="h-4 w-4" />
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Info -->
        <div class="lg:col-span-5 space-y-6">
          <div class="border border-navy-200 bg-white p-8 reveal stagger-2">
            <h2 class="font-display text-2xl text-navy-900">Contact Information</h2>
            <ul class="mt-6 space-y-5">
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center border border-navy-200 text-navy-400">
                  <Icon name="lucide:phone" class="h-4 w-4" />
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Phone</p>
                  <a href={business.phoneHref} class="mt-1 block text-sm text-navy-800 transition-colors hover:text-gold-600">{business.phone}</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center border border-navy-200 text-navy-400">
                  <Icon name="lucide:mail" class="h-4 w-4" />
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Email</p>
                  <a href={`mailto:${business.email}`} class="mt-1 block text-sm text-navy-800 transition-colors hover:text-gold-600">{business.email}</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center border border-navy-200 text-navy-400">
                  <Icon name="lucide:map-pin" class="h-4 w-4" />
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Location</p>
                  <p class="mt-1 text-sm text-navy-500">{business.address.street}, {business.address.city}</p>
                  <p class="text-sm text-navy-500">P.O. Box {business.address.zip}</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center border border-navy-200 text-navy-400">
                  <Icon name="lucide:clock" class="h-4 w-4" />
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-navy-400">Hours</p>
                  {business.hours.map((h) => (
                    <p class="mt-1 text-sm text-navy-500"><span class="text-navy-800">{h.days}:</span> {h.hours}</p>
                  ))}
                </div>
              </li>
            </ul>
          </div>

          <div class="border border-gold-200 bg-gold-50 p-6 reveal stagger-3">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center bg-gold-600 text-white">
                <Icon name="lucide:alert-triangle" class="h-4 w-4" />
              </div>
              <div>
                <p class="text-sm font-bold text-navy-900">MEP Emergency?</p>
                <p class="mt-1 text-sm text-navy-500">
                  Call us immediately at <a href={business.phoneHref} class="text-gold-600 underline">{business.phone}</a>. We provide 24/7 emergency service.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
