    100% { opacity: 0; transform: translateY(14px); }
  }

  .process-line {
    transform: scaleY(0);
    transition: transform 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.3s;
  }

  :global(.visible) .process-line {
    transform: scaleY(1);
  }
</style>
