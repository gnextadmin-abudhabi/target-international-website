---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { yearsInBusiness } from '../data/business';
import { serviceUrl, areaUrl, contactUrl, servicesUrl } from '../lib/urls';
import { areaImage } from '../lib/images';
import CtaBanner from '../components/CtaBanner.astro';
import { getLang, translator, formatDate } from '../i18n';
import { getBusiness, getServices, getAreas, getReviews, averageRating } from '../i18n/data';

const lang = getLang(Astro.url);
const t = translator(lang);
const business = getBusiness(lang);
const serviceTypes = getServices(lang);
const serviceAreas = getAreas(lang);
const reviews = getReviews(lang);

const years = yearsInBusiness();
const avgRating = averageRating().toFixed(1);
const isClosed = (hours: string) => hours === 'Closed' || hours === 'مغلق';

const heroBadges = [
  { icon: 'lucide:shield-check', line1: t('Licensed', 'مرخّصة'), line2: t('& Insured', 'ومؤمّنة') },
  { icon: 'lucide:award', line1: t('ISO', 'حاصلة على'), line2: t('Certified', 'شهادات ISO') },
  { icon: 'lucide:headset', line1: t('24/7 Emergency', 'دعم الطوارئ'), line2: t('Support', 'على مدار الساعة') },
  { icon: 'lucide:calendar-check', line1: t(`${years}+ Years`, `+${years} عاماً`), line2: t('Experience', 'من الخبرة') },
];


const processSteps = [
  { step: '01', title: t('Consultation', 'الاستشارة'), desc: t('Discuss your project and schedule a comprehensive site survey.', 'نناقش مشروعك ونحدد موعداً لمسح شامل للموقع.') },
  { step: '02', title: t('Design & Proposal', 'التصميم والعرض'), desc: t('Engineered solutions with detailed drawings and specifications.', 'حلول هندسية مع مخططات ومواصفات تفصيلية.') },
  { step: '03', title: t('Execution', 'التنفيذ'), desc: t('Expert installation by certified teams, on time and to specification.', 'تركيب احترافي على أيدي فرق معتمدة، في الوقت المحدد ووفق المواصفات.') },
  { step: '04', title: t('Commissioning', 'التشغيل والتسليم'), desc: t('Full testing, balancing, and handover with complete documentation.', 'اختبار وموازنة كاملة وتسليم مع توثيق شامل.') },
];

const stats: { num: string; label: string; icon: string; count?: number; suffix?: string }[] = [
  { num: `${years}+`, label: t('Years Experience', 'عاماً من الخبرة'), icon: 'lucide:calendar-check', count: years, suffix: '+' },
  { num: 'ISO', label: t('Triple Certified', 'ثلاث شهادات معتمدة'), icon: 'lucide:badge-check' },
  { num: '24/7', label: t('Emergency Support', 'دعم الطوارئ'), icon: 'lucide:headset' },
  { num: '100%', label: t('Licensed & Insured', 'مرخّصة ومؤمّنة'), icon: 'lucide:shield-check', count: 100, suffix: '%' },
];

// Brand partners section; partners without a logo file yet show their name.
const brandPartners: { name: string; logo?: string; size?: string }[] = [
  { name: 'Hitachi', logo: '/images/partners/hitachi.svg' },
  { name: 'TCL', logo: '/images/partners/tcl.svg' },
  { name: '3 Max', logo: '/images/partners/3max.png', size: 'h-16 w-36 sm:h-20 sm:w-44' },
  { name: 'Duct Masters', logo: '/images/partners/duct-masters.png', size: 'h-16 w-36 sm:h-20 sm:w-44' },
];

const whyItems = [
  { icon: 'lucide:landmark', text: t('Licensed by Abu Dhabi Department of Economic Development', 'مرخّصة من دائرة التنمية الاقتصادية في أبوظبي') },
  { icon: 'lucide:badge-check', text: t('ISO 9001, 14001, and 45001 Certified', 'حاصلة على شهادات ISO 9001 و14001 و45001') },
  { icon: 'lucide:handshake', text: t('Prequalified with Aldar, DMT, and Parsons International', 'مؤهلة مسبقاً لدى الدار ودائرة البلديات والنقل وبارسونز إنترناشيونال') },
  { icon: 'lucide:factory', text: t('In-house duct fabrication facility', 'مصنع داخلي لتصنيع مجاري الهواء') },
];

const pageTitle = t(`${business.name} | Abu Dhabi MEP Contractor`, `${business.name} | مقاول الأعمال الكهروميكانيكية في أبوظبي`);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${business.website}/#website`,
      url: business.website,
      name: business.name,
      description: business.description,
      inLanguage: lang,
      publisher: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'GeneralContractor',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      founder: { '@type': 'Person', name: business.owner },
      sameAs: [business.socialMedia.linkedin, business.socialMedia.instagram].filter(Boolean),
      foundingDate: `${business.yearEstablished}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        postalCode: business.address.zip,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '08:00',
          closes: '18:00',
        },
      ],
      areaServed: serviceAreas.map((area) => ({
        '@type': 'City',
        name: area.name,
        containedInPlace: { '@type': 'AdministrativeArea', name: area.county },
      })),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t('MEP Contracting Services', 'خدمات مقاولات الأعمال الكهروميكانيكية'),
        itemListElement: serviceTypes.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service.name,
            description: service.shortDescription,
          },
        })),
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${business.website}${lang === 'ar' ? '/ar/' : '/'}#webpage`,
      url: `${business.website}${lang === 'ar' ? '/ar/' : ''}`,
      name: pageTitle,
      inLanguage: lang,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
      description: business.description,
    },
  ],
};
---

<BaseLayout title={pageTitle} description={business.description} schema={schema}>
  <!-- ============ HERO ============ -->
  <section class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-navy-950 lg:min-h-[94vh]">
    <!-- Photo fills the end side on desktop, full-bleed on mobile -->
    <div class="absolute inset-y-0 end-0 -z-20 w-full lg:w-[66%]">
      <img
        src="/images/hero-team.webp"
        alt={t('Target International engineers servicing a rooftop AC unit with the Abu Dhabi skyline behind', 'مهندسو تارجت إنترناشيونال يصونون وحدة تكييف على سطح مبنى مع أفق أبوظبي في الخلفية')}
        class="hero-photo h-full w-full object-cover object-[60%_center]"
        width="1228"
        height="768"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <!-- Navy fade: solid behind the copy, blending into the photo -->
    <div class="hero-fade rtl-mirror absolute inset-0 -z-10"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-navy-950/70 to-transparent"></div>

    <div class="container-x pb-14 pt-32 sm:pt-36 lg:pb-20 lg:pt-40">
      <div class="max-w-2xl">
        <span class="animate-fade-up inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-gold-400 sm:text-sm">
          {t('Built on Trust. Engineered to Last.', 'مبنية على الثقة. مصممة لتدوم.')}
        </span>

        <h1 class="animate-fade-up stagger-1 mt-5 font-display text-[2.75rem] leading-[1.02] text-white sm:text-6xl lg:text-7xl rtl:text-[2.4rem] rtl:sm:text-5xl rtl:lg:text-6xl">
          {lang === 'ar' ? (
            <Fragment>شريكك الموثوق في الأعمال الكهروميكانيكية في <span class="text-gold-400">أبوظبي.</span></Fragment>
          ) : (
            <Fragment>Your Trusted MEP Partner in <span class="text-gold-400">Abu Dhabi.</span></Fragment>
          )}
        </h1>

        <p class="animate-fade-up stagger-2 mt-6 max-w-xl text-base leading-relaxed text-navy-100 sm:text-lg">
          {t(
            `${business.tagline}. Backed by ${years}+ years of experience, triple ISO certification, and a portfolio of landmark projects across the UAE.`,
            `${business.tagline}، مدعومة بخبرة تزيد عن ${years} عاماً، وثلاث شهادات ISO، وسجل حافل بالمشاريع البارزة في جميع أنحاء الإمارات.`,
          )}
        </p>

        <div class="animate-fade-up stagger-3 mt-9 flex flex-wrap gap-3">
          <a href={contactUrl(lang)} class="btn-gold !rounded-md !px-7 uppercase tracking-[0.08em]">
            {t('Get a Free Quote', 'احصل على عرض سعر مجاني')}
            <Icon name="lucide:arrow-right" class="btn-arrow h-4 w-4" />
          </a>
          <a href={servicesUrl(lang)} class="btn-ghost-light !rounded-md !border-white/60 !px-7 uppercase tracking-[0.08em]">
            {t('View Our Services', 'تعرّف على خدماتنا')}
          </a>
        </div>

        <!-- Trust badges -->
        <ul class="animate-fade-up stagger-4 mt-12 grid grid-cols-2 gap-y-6 sm:flex sm:flex-wrap sm:items-center sm:gap-0 sm:divide-x sm:divide-white/20">
          {heroBadges.map((badge) => (
            <li class="flex items-center gap-3 sm:px-6 sm:first:ps-0">
              <Icon name={badge.icon} class="h-8 w-8 shrink-0 text-gold-400" />
              <span class="text-sm font-semibold leading-tight text-white">
                {badge.line1}<br />{badge.line2}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Scroll cue -->
    <a
      href="#partners"
      aria-label={t('Scroll down', 'انتقل للأسفل')}
      class="absolute bottom-6 left-1/2 hidden h-11 w-7 -translate-x-1/2 justify-center rounded-full border-2 border-white/40 pt-2 transition-colors hover:border-gold-400 lg:flex"
    >
      <span class="scroll-dot block h-2 w-1 rounded-full bg-gold-400"></span>
    </a>
  </section>

  <!-- ============ OUR PARTNERS ============ -->
  <section id="partners" class="relative overflow-hidden bg-surface py-20 lg:py-28">
    <div class="bg-glow-light pointer-events-none absolute inset-0"></div>
    <div class="container-x relative">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="section-label justify-center">{t('Our Partners', 'شركاؤنا')}</span>
        <h2 class="section-title mt-5">{t('Glad to Have Our Partners', 'نفخر بشركائنا')}</h2>
      </div>

      <!-- Infinite logo slider: the set is repeated so one half always covers the widest screen, then the track loops by -50% -->
      <div class="logo-slider reveal mt-12 overflow-hidden py-3" dir="ltr">
        <ul class="logo-track flex w-max">
          {[...brandPartners, ...brandPartners, ...brandPartners, ...brandPartners].map((partner, i) => (
            <li class="shrink-0 px-2.5 sm:px-3" aria-hidden={i >= brandPartners.length ? 'true' : undefined}>
              <div class="card group flex h-28 w-52 items-center justify-center p-6 transition-all duration-500 hover:-translate-y-1 hover:border-gold-200 hover:shadow-[var(--shadow-lift)] sm:h-32 sm:w-64 sm:p-8" title={partner.name}>
                {partner.logo ? (
                  <img
                    src={partner.logo}
                    alt={i < brandPartners.length ? partner.name : ''}
                    class:list={[partner.size ?? 'h-10 w-32 sm:h-12 sm:w-40', 'object-contain transition-transform duration-500 group-hover:scale-105']}
                    width="220"
                    height="56"
                    loading="lazy"
                  />
                ) : (
                  <span class="text-center text-xl font-extrabold uppercase tracking-[0.08em] text-navy-300 transition-colors duration-500 group-hover:text-navy-800 sm:text-2xl" style="font-family: 'DM Sans', sans-serif">
                    {partner.name}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="relative bg-white py-20 lg:py-28">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="reveal lg:col-span-7">
          <span class="section-label">{t('What We Do', 'ماذا نقدّم')}</span>
          <h2 class="section-title mt-5">{t('Our MEP Services', 'خدماتنا في الأعمال الكهروميكانيكية')}</h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-navy-500">
            {t(
              'From design and supply to installation, testing, and ongoing maintenance — we deliver end-to-end MEP solutions for every type of building project.',
              'من التصميم والتوريد إلى التركيب والاختبار والصيانة المستمرة — نقدّم حلول MEP متكاملة لجميع أنواع مشاريع المباني.',
            )}
          </p>
          <div class="mt-8">
            <a href={servicesUrl(lang)} class="btn-primary">
              {t('View All Services', 'عرض جميع الخدمات')}
              <Icon name="lucide:arrow-right" class="btn-arrow h-4 w-4" />
            </a>
          </div>
        </div>

        <div class="reveal stagger-2 lg:col-span-5">
          <div class="card p-6">
            <div class="flex items-start gap-4">
              <span class="icon-tile shrink-0">
                <Icon name="lucide:clock" class="h-5 w-5" />
              </span>
              <dl class="flex-1 space-y-2 text-sm">
                {business.hours.map((h) => (
                  <div class="flex justify-between gap-4">
                    <dt class="font-semibold text-navy-800">{h.days}</dt>
                    <dd class:list={[isClosed(h.hours) ? 'text-navy-400' : 'text-navy-600']}>{h.hours}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div class="mt-5 flex items-center gap-2 border-t border-navy-100 pt-4 text-sm font-semibold text-gold-700">
              <span class="h-2 w-2 animate-pulse rounded-full bg-gold-500"></span>
              {business.emergencyCta}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {serviceTypes.map((service, i) => (
          <a
            href={serviceUrl(service.slug, lang)}
            class={`card card-hover group flex flex-col overflow-hidden reveal stagger-${(i % 4) + 1}`}
          >
            <div class="img-hover relative aspect-[4/3] overflow-hidden">
              <img src={service.image} alt={service.name} class="h-full w-full object-cover" width="600" height="450" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/50 via-transparent to-transparent"></div>
              {service.emergency && (
                <span class="absolute end-3 top-3 rounded-full bg-red-600 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">24/7</span>
              )}
            </div>
            <div class="relative flex flex-1 flex-col p-6 pt-8">
              <span class="icon-tile absolute -top-6 start-6 bg-white shadow-[var(--shadow-soft)] ring-1 ring-navy-100">
                <Icon name={service.icon} class="h-5 w-5" />
              </span>
              <h3 class="text-lg font-semibold leading-snug text-navy-900 transition-colors group-hover:text-gold-700">
                {service.name}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-500 line-clamp-3">
                {service.shortDescription}
              </p>
              <div class="mt-5 flex items-center justify-between border-t border-navy-100 pt-4">
                <span class="text-xs font-bold uppercase tracking-wider text-gold-600">{t('Learn More', 'اعرف المزيد')}</span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-50 text-navy-700 transition-all duration-300 group-hover:bg-navy-800 group-hover:text-white">
                  <Icon name="lucide:arrow-up-right" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" />
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="relative overflow-hidden bg-surface py-20 lg:py-28">
    <div class="bg-glow-light pointer-events-none absolute inset-0"></div>
    <div class="container-x relative">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <div class="reveal">
            <span class="section-label">{t('How We Work', 'كيف نعمل')}</span>
            <h2 class="section-title mt-5 max-w-xl">{t('A Proven Process for Every Project', 'منهجية مجرّبة لكل مشروع')}</h2>
          </div>
          <div class="img-reveal relative mt-10 overflow-hidden rounded-[1.25rem]">
            <div class="img-hover">
              <img
                src="/images/services/mep-design-supply-installation.webp"
                alt={t('MEP design and installation by Target International', 'تصميم وتركيب الأعمال الكهروميكانيكية من تارجت إنترناشيونال')}
                class="aspect-[16/10] w-full object-cover"
                width="1189"
                height="768"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="reveal reveal-right stagger-2 lg:col-span-5 lg:self-end">
          <div class="card relative p-7 sm:p-9">
            <ol class="relative space-y-8">
              <span class="absolute bottom-3 start-[1.1875rem] top-3 w-px bg-navy-100" aria-hidden="true">
                <span class="process-line block h-full w-full origin-top bg-gold-400"></span>
              </span>
              {processSteps.map((item) => (
                <li class="group relative flex gap-5">
                  <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-gold-400 bg-white text-xs font-bold text-navy-800 transition-colors group-hover:bg-gold-500 group-hover:text-white">
                    {item.step}
                  </span>
                  <div class="pt-1.5">
                    <h3 class="text-base font-semibold text-navy-900">{item.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-navy-500">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
            <a
              href={contactUrl(lang)}
              aria-label={t('Request a Quote', 'اطلب عرض سعر')}
              class="absolute bottom-7 end-7 hidden h-14 w-14 items-center justify-center rounded-full bg-navy-800 text-white shadow-[var(--shadow-lift)] transition-all hover:scale-110 hover:bg-gold-600 sm:flex"
            >
              <Icon name="lucide:arrow-right" class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="reveal mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-[1.25rem] border border-navy-100 bg-navy-100 shadow-[var(--shadow-soft)] lg:mt-16 lg:grid-cols-4">
        {stats.map((stat) => (
          <div class="group flex items-center gap-4 bg-white p-5 transition-colors hover:bg-gold-50 sm:p-7">
            <span class="icon-tile hidden shrink-0 sm:inline-flex">
              <Icon name={stat.icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="font-display text-2xl text-navy-900 sm:text-3xl">
                {stat.count !== undefined ? (
                  <span class="ltr" data-count={stat.count} data-suffix={stat.suffix}>{stat.num}</span>
                ) : <span class="ltr">{stat.num}</span>}
              </p>
              <p class="mt-0.5 text-xs font-medium text-navy-500 sm:text-sm">{stat.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHY CHOOSE US ============ -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-x">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="relative">
          <div class="img-reveal overflow-hidden rounded-[1.25rem]">
            <div class="img-hover">
              <img
                src="/images/about-workshop.webp"
                alt={t('Target International MEP workshop', 'ورشة تارجت إنترناشيونال للأعمال الكهروميكانيكية')}
                class="aspect-[4/3] w-full object-cover"
                width="1376"
                height="768"
                loading="lazy"
              />
            </div>
          </div>
          <div class="absolute -bottom-6 end-4 start-4 sm:-end-6 sm:start-auto sm:w-72">
            <div class="reveal stagger-3 glass flex items-center gap-4 rounded-2xl p-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-navy-800 text-gold-300">
                <Icon name="lucide:factory" class="h-5 w-5" />
              </span>
              <p class="text-sm font-semibold leading-snug text-navy-900">{t('In-house duct fabrication facility', 'مصنع داخلي لتصنيع مجاري الهواء')}</p>
            </div>
          </div>
        </div>

        <div class="reveal reveal-right stagger-2 pt-6 lg:pt-0">
          <span class="section-label">{t('Why Target International', 'لماذا تارجت إنترناشيونال')}</span>
          <h2 class="section-title mt-5">
            {lang === 'ar' ? <Fragment>مبنية على الثقة.<br />مصممة لتدوم.</Fragment> : <Fragment>Built on Trust.<br />Engineered to Last.</Fragment>}
          </h2>
          <p class="mt-5 text-base leading-relaxed text-navy-500">
            {t(
              'We combine technical expertise with deep local market knowledge to deliver MEP solutions that exceed expectations. Every project benefits from our commitment to quality, safety, and innovation.',
              'نجمع بين الخبرة التقنية والمعرفة العميقة بالسوق المحلي لنقدّم حلول MEP تفوق التوقعات. ويستفيد كل مشروع من التزامنا بالجودة والسلامة والابتكار.',
            )}
          </p>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {whyItems.map((item) => (
              <li class="group flex items-start gap-3 rounded-2xl border border-navy-100 bg-surface p-4 transition-all hover:border-gold-200 hover:bg-white hover:shadow-[var(--shadow-soft)]">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-100 text-gold-700 transition-colors group-hover:bg-gold-600 group-hover:text-white">
                  <Icon name={item.icon} class="h-4 w-4" />
                </span>
                <span class="text-sm font-medium leading-snug text-navy-700">{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="relative overflow-hidden bg-navy-900 py-20 lg:py-28">
    <div class="bg-glow pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute -start-32 top-1/3 h-96 w-96 rounded-full bg-gold-500/10 blur-3xl"></div>
    <div class="container-x relative">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="reveal">
          <span class="section-label !text-gold-300">{t('Testimonials', 'آراء العملاء')}</span>
          <h2 class="section-title mt-5 !text-white">{t('What Our Clients Say', 'ماذا يقول عملاؤنا')}</h2>
        </div>
        <div class="reveal stagger-1 flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 px-5 py-4 backdrop-blur">
          <span class="font-display text-4xl text-white">{avgRating}</span>
          <div>
            <div class="flex gap-0.5">
              {[1, 2, 3, 4, 5].map(() => (
                <Icon name="lucide:star" class="h-4 w-4 fill-gold-400 text-gold-400" />
              ))}
            </div>
            <span class="mt-1 block text-xs text-navy-300">{t(`from ${reviews.length} reviews`, `من ${reviews.length} تقييماً`)}</span>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {reviews.slice(0, 4).map((review, i) => (
          <figure class={`group flex flex-col rounded-[1.25rem] border border-white/10 bg-white/[0.04] p-6 backdrop-blur transition-all duration-500 hover:-translate-y-1.5 hover:border-gold-400/40 hover:bg-white/[0.08] reveal stagger-${i + 1}`}>
            <div class="flex items-center justify-between">
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, j) => (
                  <Icon name="lucide:star" class={`h-3.5 w-3.5 ${j < review.rating ? 'fill-gold-400 text-gold-400' : 'text-navy-600'}`} />
                ))}
              </div>
              <Icon name="lucide:quote" class="h-7 w-7 text-gold-500/40 transition-colors group-hover:text-gold-400" />
            </div>
            <blockquote class="mt-5 flex-1 text-sm leading-relaxed text-navy-100">
              {lang === 'ar' ? `«${review.text}»` : `"${review.text}"`}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-white/10 pt-5">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold-600 text-sm font-bold text-white">
                {review.author.charAt(0)}
              </span>
              <span>
                <span class="block text-sm font-semibold text-white">{review.author}</span>
                <span class="block text-xs text-navy-300">{formatDate(review.date, lang, { month: 'short', year: 'numeric' })}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="bg-surface py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="reveal">
          <span class="section-label">{t('Coverage', 'نطاق الخدمة')}</span>
          <h2 class="section-title mt-5">{t('Areas We Serve', 'المناطق التي نخدمها')}</h2>
        </div>
        <p class="reveal stagger-1 max-w-md text-base text-navy-500">
          {t(
            'Proudly serving Abu Dhabi and the Western Region with fast response times and reliable MEP contracting services.',
            'نفخر بخدمة أبوظبي والمنطقة الغربية بأوقات استجابة سريعة وخدمات مقاولات كهروميكانيكية موثوقة.',
          )}
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {serviceAreas.map((area, i) => (
          <a
            href={areaUrl(area.slug, lang)}
            class={`group relative isolate flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-[1.5rem] p-7 shadow-[var(--shadow-soft)] sm:p-9 reveal stagger-${i + 1}`}
          >
            <img
              src={areaImage(area.slug)}
              alt={t(`MEP services in ${area.name}`, `خدمات الأعمال الكهروميكانيكية في ${area.name}`)}
              class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105"
              width="1376"
              height="768"
              loading="lazy"
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950/95 via-navy-900/50 to-navy-900/10 transition-colors duration-500 group-hover:from-navy-950"></div>
            <div class="flex items-end justify-between gap-6">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-gold-300">{area.county}</p>
                <h3 class="mt-2 font-display text-3xl text-white sm:text-4xl">{area.name}</h3>
                <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur">
                  <Icon name="lucide:clock" class="h-3.5 w-3.5 text-gold-300" />
                  {t(`${area.responseTime} response`, `استجابة خلال ${area.responseTime}`)}
                </p>
              </div>
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-navy-900 transition-all duration-300 group-hover:bg-gold-500 group-hover:text-white">
                <Icon name="lucide:arrow-up-right" class="h-5 w-5 transition-transform duration-300 group-hover:rotate-45" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <CtaBanner
    label={t('Get Started', 'ابدأ الآن')}
    title={t('Ready to Start<br />Your Project?', 'هل أنت مستعد<br />لبدء مشروعك؟')}
    text={t(
      'Call us now or send a message. We are here to help with any MEP project, big or small, across Abu Dhabi and the Western Region.',
      'اتصل بنا الآن أو أرسل رسالة. نحن هنا لمساعدتك في أي مشروع كهروميكانيكي، كبيراً كان أو صغيراً، في أبوظبي والمنطقة الغربية.',
    )}
  />
</BaseLayout>

<style>
  .hero-photo {
    animation: heroIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes heroIn {
    from { opacity: 0; transform: scale(1.03); }
    to { opacity: 1; transform: none; }
  }

  /* Mobile: text sits over the whole photo, so darken evenly */
  .hero-fade {
    background:
      linear-gradient(180deg, rgba(12, 19, 31, 0.55) 0%, rgba(12, 19, 31, 0.75) 100%),
      linear-gradient(90deg, rgba(12, 19, 31, 0.6) 0%, rgba(12, 19, 31, 0.2) 100%);
  }

  /* Desktop: solid navy behind the copy, blending into the photo, which stays clear on the far side */
  @media (min-width: 1024px) {
    .hero-fade {
      background: linear-gradient(
        90deg,
        rgba(12, 19, 31, 1) 0%,
        rgba(12, 19, 31, 1) 34%,
        rgba(12, 19, 31, 0.75) 44%,
        rgba(12, 19, 31, 0.25) 56%,
        rgba(12, 19, 31, 0) 66%
      );
    }
  }

  .logo-slider {
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .logo-track {
    animation: logoScroll 32s linear infinite;
  }

  .logo-slider:hover .logo-track {
    animation-play-state: paused;
  }

  @keyframes logoScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .scroll-dot {
    animation: scrollDot 1.8s ease-in-out infinite;
  }

  @keyframes scrollDot {
    0% { opacity: 0; transform: translateY(0); }
