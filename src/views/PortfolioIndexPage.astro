---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { projectsUrl } from '../lib/urls';
import { getLang, translator } from '../i18n';
import { getBusiness } from '../i18n/data';
import { getProjects, categoryLabels } from '../data/portfolio';

const lang = getLang(Astro.url);
const t = translator(lang);
const business = getBusiness(lang);
const projects = getProjects(lang);

const totalPhotos = projects.reduce((s, p) => s + p.photoCount, 0);
const totalVideos = projects.reduce((s, p) => s + p.videoCount, 0);
const usedCategories = [...new Set(projects.map((p) => p.categoryKey))];

const stats = [
  { value: projects.length, label: t('Featured Projects', 'مشاريع مختارة'), icon: 'lucide:folder-kanban' },
  { value: totalPhotos, label: t('Project Photos', 'صور المشاريع'), icon: 'lucide:image' },
  { value: totalVideos, label: t('Site Videos', 'فيديوهات المواقع'), icon: 'lucide:clapperboard' },
];
---

<BaseLayout
  title={t(`Projects | ${business.name}`, `مشاريعنا | ${business.name}`)}
  description={t(
    `Explore completed MEP and HVAC projects by ${business.name} across Abu Dhabi: villas, buildings, outdoor cooling and duct cleaning.`,
    `استكشف مشاريع الأعمال الكهروميكانيكية والتكييف المنجزة من ${business.name} في أبوظبي: فلل ومبانٍ وتبريد خارجي وتنظيف مجاري الهواء.`,
  )}
>
  <PageHero
    crumbs={[{ label: t('Projects', 'مشاريعنا') }]}
    label={t('Our Work', 'أعمالنا')}
    title={t('Our Projects', 'مشاريعنا')}
    description={t(
      'A selection of HVAC and MEP projects delivered by our teams across Abu Dhabi — from private villas and building construction to outdoor cooling and duct cleaning.',
      'مجموعة مختارة من مشاريع التكييف والأعمال الكهروميكانيكية التي نفذتها فرقنا في أبوظبي — من الفلل الخاصة ومشاريع البناء إلى التبريد الخارجي وتنظيف مجاري الهواء.',
    )}
    image={projects[0].coverSrc!}
    imageAlt={projects[0].title}
  />

  <!-- Stats -->
  <section class="relative overflow-hidden bg-navy-950 py-10 lg:py-12">
    <div class="bg-glow pointer-events-none absolute inset-0 opacity-70"></div>
    <div class="container-x relative grid grid-cols-3 gap-px overflow-hidden rounded-[1.25rem] border border-white/10 bg-white/10">
      {stats.map((s, i) => (
        <div class={`flex flex-col items-center gap-2 bg-navy-950/90 p-5 text-center sm:flex-row sm:justify-center sm:gap-4 sm:p-7 reveal stagger-${i + 1}`}>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-gold-300">
            <Icon name={s.icon} class="h-5 w-5" />
          </span>
          <div class="sm:text-start">
            <p class="font-display text-3xl text-white sm:text-4xl"><span data-count={s.value}>{s.value}</span></p>
            <p class="text-xs font-medium text-navy-200 sm:text-sm">{s.label}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="reveal">
          <span class="section-label">{t('Selected Work', 'أعمال مختارة')}</span>
          <h2 class="section-title mt-5">{t('Featured Projects', 'مشاريع مميزة')}</h2>
        </div>

        <!-- Filter -->
        <div class="reveal stagger-1 flex flex-wrap gap-2" role="group" aria-label={t('Filter projects', 'تصفية المشاريع')} data-filter-bar>
          <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">{t('All', 'الكل')}</button>
          {usedCategories.map((key) => (
            <button type="button" class="filter-chip" data-filter={key} aria-pressed="false">{categoryLabels[key][lang]}</button>
          ))}
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-filter-grid>
        {projects.map((p, i) => (
          <a
            href={projectsUrl(p.slug, lang)}
            data-category={p.categoryKey}
            class:list={[
              'project-card group relative isolate flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-[1.5rem] bg-navy-900 p-6 shadow-[var(--shadow-soft)] transition-shadow duration-500 hover:shadow-[var(--shadow-lift)] sm:p-7 reveal',
              `stagger-${(i % 3) + 1}`,
              i === 0 && 'md:col-span-2 md:min-h-[28rem] lg:col-span-3 lg:min-h-[32rem]',
            ]}
          >
            <img
              src={i === 0 ? p.coverSrc : p.coverThumb}
              alt={p.title}
              class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105"
              width={p.cover?.w}
              height={p.cover?.h}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950 via-navy-950/55 to-navy-950/5 transition-opacity duration-500 group-hover:opacity-95"></div>

            <div class="absolute start-5 top-5 flex flex-wrap gap-2">
              <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-navy-800 backdrop-blur">{p.category}</span>
              {p.hasBeforeAfter && (
                <span class="rounded-full bg-gold-500 px-3 py-1 text-xs font-bold text-white">{t('Before & After', 'قبل وبعد')}</span>
              )}
            </div>

            <div class="flex items-end justify-between gap-5">
              <div class="min-w-0">
                <p class="flex items-center gap-1.5 text-xs font-semibold text-gold-300">
                  <Icon name="lucide:map-pin" class="h-3.5 w-3.5" />
                  {p.location}
                </p>
                <h3 class:list={['mt-2 font-display text-white', i === 0 ? 'text-3xl sm:text-4xl' : 'text-2xl']}>{p.title}</h3>
                {i === 0 && <p class="mt-3 max-w-lg text-sm leading-relaxed text-navy-100">{p.summary}</p>}
                <p class="mt-4 flex flex-wrap items-center gap-4 text-xs font-medium text-navy-200">
                  {p.photoCount > 0 && (
                    <span class="inline-flex items-center gap-1.5"><Icon name="lucide:image" class="h-4 w-4 text-gold-300" />{p.photoCount} {t('photos', 'صورة')}</span>
                  )}
                  {p.videoCount > 0 && (
                    <span class="inline-flex items-center gap-1.5"><Icon name="lucide:play-circle" class="h-4 w-4 text-gold-300" />{p.videoCount} {t(p.videoCount === 1 ? 'video' : 'videos', 'فيديو')}</span>
                  )}
                </p>
              </div>
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-navy-900 transition-all duration-300 group-hover:bg-gold-500 group-hover:text-white">
                <Icon name="lucide:arrow-up-right" class="h-5 w-5 transition-transform duration-300 group-hover:rotate-45" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    label={t('Start a Project', 'ابدأ مشروعك')}
    title={t('Have a Project<br />in Mind?', 'هل لديك مشروع<br />في ذهنك؟')}
    text={t(
      'Tell us about your building and requirements. Our engineers will visit your site and prepare a detailed proposal.',
      'أخبرنا عن مبناك ومتطلباتك. سيزور مهندسونا موقعك ويعدّون لك عرضاً تفصيلياً.',
    )}
    secondaryLabel={t('Request a Quote', 'اطلب عرض سعر')}
  />
</BaseLayout>

<style>
  .filter-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-navy-100);
    background: white;
    padding: 0.55rem 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-navy-600);
    transition: all 0.25s ease;
  }

  .filter-chip:hover {
    border-color: var(--color-gold-300);
    color: var(--color-navy-900);
  }

  .filter-chip[aria-pressed='true'] {
    border-color: var(--color-navy-800);
    background: var(--color-navy-800);
    color: white;
  }

  .project-card[hidden] {
    display: none;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const grid = document.querySelector<HTMLElement>('[data-filter-grid]');
  if (bar && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'));
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const f = btn.dataset.filter;
      bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.category === f;
        c.hidden = !show;
        c.classList.add('visible');
      });
    });
  }
</script>
