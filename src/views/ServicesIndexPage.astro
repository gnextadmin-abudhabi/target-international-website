---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { serviceUrl } from '../lib/urls';
import { getLang, translator } from '../i18n';
import { getBusiness, getServices } from '../i18n/data';

const lang = getLang(Astro.url);
const t = translator(lang);
const business = getBusiness(lang);
const serviceTypes = getServices(lang);
---

<BaseLayout
  title={t(`MEP Services | ${business.name}`, `خدمات الأعمال الكهروميكانيكية | ${business.name}`)}
  description={t(
    `${business.name} offers a full range of MEP contracting services across ${business.serviceRadius}. From design and installation to maintenance and TAB reporting.`,
    `تقدّم ${business.name} مجموعة متكاملة من خدمات مقاولات الأعمال الكهروميكانيكية في ${business.serviceRadius}، من التصميم والتركيب إلى الصيانة وتقارير الاختبار والضبط والموازنة (TAB).`,
  )}
>
  <PageHero
    crumbs={[{ label: t('Services', 'الخدمات') }]}
    label={t('What We Do', 'ماذا نقدّم')}
    title={t('Our MEP Services', 'خدماتنا في الأعمال الكهروميكانيكية')}
    description={t(
      'Whether you need a complete MEP design and installation for a new tower or ongoing maintenance for an existing facility, we provide comprehensive solutions for residential, commercial, and industrial projects.',
      'سواء كنت بحاجة إلى تصميم وتركيب متكامل لأعمال MEP في برج جديد أو صيانة مستمرة لمنشأة قائمة، نقدّم حلولاً شاملة للمشاريع السكنية والتجارية والصناعية.',
    )}
    image="/images/project-chiller.webp"
    imageAlt={t('Chiller maintenance on an Abu Dhabi rooftop', 'صيانة مبرّد على سطح مبنى في أبوظبي')}
    imagePosition="center 35%"
  />

  <section class="bg-surface py-20 lg:py-28">
    <div class="container-x space-y-6 lg:space-y-8">
      {serviceTypes.map((service, i) => (
        <a
          href={serviceUrl(service.slug, lang)}
          class="card card-hover group grid overflow-hidden reveal md:grid-cols-2"
        >
          <div class:list={['img-hover relative aspect-[16/10] overflow-hidden md:aspect-auto md:min-h-[20rem]', i % 2 === 1 && 'md:order-2']}>
            <img
              src={service.image}
              alt={service.name}
              class="absolute inset-0 h-full w-full object-cover"
              width="800"
              height="500"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/40 via-transparent to-transparent"></div>
            <span class="absolute start-5 top-5 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-navy-800 backdrop-blur">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
            <div class="flex flex-wrap items-center gap-3">
              <span class="icon-tile">
                <Icon name={service.icon} class="h-5 w-5" />
              </span>
              {service.emergency && (
                <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-red-600">{t('24/7 Emergency', 'طوارئ على مدار الساعة')}</span>
              )}
            </div>
            <h2 class="mt-5 text-2xl font-semibold leading-snug text-navy-900 transition-colors group-hover:text-gold-700 sm:text-3xl">{service.name}</h2>
            <p class="mt-3 max-w-xl text-base leading-relaxed text-navy-500">{service.shortDescription}</p>
            <div class="mt-7 flex items-center justify-between gap-4 border-t border-navy-100 pt-5">
              <span class="text-sm font-bold uppercase tracking-[0.08em] text-gold-600">{t('Learn More', 'اعرف المزيد')}</span>
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-navy-50 text-navy-700 transition-all duration-300 group-hover:bg-navy-800 group-hover:text-white">
                <Icon name="lucide:arrow-up-right" class="h-5 w-5 transition-transform duration-300 group-hover:rotate-45" />
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaBanner
    title={t('Not Sure What You Need?', 'لست متأكداً مما تحتاجه؟')}
    text={t(
      'Call us and describe your project. We will help you figure out the right service and provide an honest estimate.',
      'اتصل بنا وصِف لنا مشروعك. سنساعدك في تحديد الخدمة المناسبة ونقدّم لك تقديراً صادقاً.',
    )}
    secondaryLabel={t('Request a Quote', 'اطلب عرض سعر')}
  />
</BaseLayout>
