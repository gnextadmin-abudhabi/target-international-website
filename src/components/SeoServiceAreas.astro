---
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { comboUrl, areaUrl } from '../lib/urls';
import { getLang } from '../i18n';
import { getAreas } from '../i18n/data';

const lang = getLang(Astro.url);
const serviceAreas = getAreas(lang);

interface Props {
  currentArea: ServiceArea;
  service?: ServiceType;
}

const { currentArea, service } = Astro.props;

// All areas except the current one
const otherAreas = serviceAreas.filter((a) => a.slug !== currentArea.slug);
---

<section class="mt-12">
  <h3 class="text-sm font-semibold text-navy-800">
    {lang === 'ar'
      ? (service ? `${service.name} في مناطق أخرى` : 'مناطق أخرى نخدمها')
      : (service ? `${service.name} in other areas` : 'Other areas we serve')}
  </h3>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {otherAreas.map((area) => (
      <a
        href={service ? comboUrl(area.slug, service.slug, lang) : areaUrl(area.slug, lang)}
        class="group flex items-center justify-between gap-3 rounded-2xl border border-navy-100 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-gold-200 hover:shadow-[var(--shadow-soft)]"
      >
        <span>
          <span class="font-semibold text-navy-800 group-hover:text-gold-700">
            {area.name}
          </span>
          <span class="mt-1 block text-sm text-navy-400">
            {area.county}
          </span>
        </span>
        <span class="text-gold-500 transition-transform group-hover:translate-x-1"><span class="inline-block rtl:-scale-x-100">&rarr;</span></span>
      </a>
    ))}
  </div>
</section>
