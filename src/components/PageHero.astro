---
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  label?: string;
  title: string;
  description?: string;
  image: string;
  imageAlt: string;
  imagePosition?: string;
}

const { crumbs, label, title, description, image, imageAlt, imagePosition = 'center' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="relative isolate overflow-hidden bg-navy-950">
  <img
    src={image}
    alt={imageAlt}
    class="animate-ken-burns absolute inset-0 -z-10 h-full w-full object-cover"
    style={`object-position: ${imagePosition}`}
    width="1600"
    height="900"
    loading="eager"
    fetchpriority="high"
  />
  <div class="rtl-mirror absolute inset-0 -z-10 bg-gradient-to-r from-navy-950/95 via-navy-900/80 to-navy-900/30"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950/70 via-transparent to-transparent"></div>
  <div class="bg-glow absolute inset-0 -z-10 opacity-40"></div>

  <div
    class:list={[
      'container-x grid gap-10 pb-16 pt-32 sm:pb-20 sm:pt-36 lg:pb-24 lg:pt-44',
      hasAside && 'lg:grid-cols-12 lg:items-end',
    ]}
  >
    <div class:list={[hasAside ? 'lg:col-span-7' : 'max-w-3xl']}>
      <div class="animate-fade-up">
        <Breadcrumbs crumbs={crumbs} variant="light" />
      </div>
      {label && (
        <span class="section-label animate-fade-up stagger-1 mt-8 !text-gold-300">{label}</span>
      )}
      <h1 class="animate-fade-up stagger-2 mt-5 font-display text-4xl leading-[1.05] text-white sm:text-5xl lg:text-6xl">
        <Fragment set:html={title} />
      </h1>
      {description && (
        <p class="animate-fade-up stagger-3 mt-6 max-w-2xl text-base leading-relaxed text-navy-100/90 sm:text-lg">
          {description}
        </p>
      )}
      <div class="animate-fade-up stagger-4">
        <slot />
      </div>
    </div>

    {hasAside && (
      <div class="animate-fade-up stagger-4 lg:col-span-5">
        <slot name="aside" />
      </div>
    )}
  </div>

  <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-gold-700 via-gold-400 to-gold-700"></div>
</section>
