---
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { reviews } from '../data/seoContent';
import { getLang, formatDate as fmt } from '../i18n';
import { getPageReviews } from '../i18n/data';
import { Icon } from 'astro-icon/components';

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

// Get the 3 most relevant reviews for this page
const lang = getLang(Astro.url);
const pageReviews = getPageReviews(lang, service?.slug, area.slug, 3);

// Calculate aggregate rating from ALL reviews
const avgRating =
  reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length;

// Structured data for search engines
const aggregateSchema = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: 'Target International',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: avgRating.toFixed(1),
    bestRating: '5',
    worstRating: '1',
    reviewCount: reviews.length,
  },
  review: pageReviews.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.author },
    datePublished: r.date,
    reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
    reviewBody: r.text,
  })),
};

/**
 * Format an ISO date string (YYYY-MM-DD) into a readable form.
 */
function formatDate(iso: string): string {
  return fmt(iso, lang);
}
---

<section class="mt-16 pb-4">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="text-2xl font-semibold text-navy-900 sm:text-3xl">{lang === 'ar' ? 'ماذا يقول عملاؤنا' : 'What Our Customers Say'}</h2>

    {/* Aggregate summary */}
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-0.5">
        {Array.from({ length: 5 }).map((_, i) => (
          <Icon
            name="lucide:star"
            class:list={[
              'size-5',
              i < Math.round(avgRating)
                ? 'fill-gold-500 text-gold-500'
                : 'fill-navy-100 text-navy-100',
            ]}
          />
        ))}
      </div>
      <span class="text-sm font-semibold text-navy-800">
        {avgRating.toFixed(1)} {lang === 'ar' ? 'من 5' : 'out of 5'}
      </span>
      <span class="text-sm text-navy-400">
        {lang === 'ar' ? `بناءً على ${reviews.length} تقييماً` : `based on ${reviews.length} reviews`}
      </span>
    </div>
  </div>

  {/* Individual review cards */}
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {pageReviews.map((review) => {
      const fullStars = Math.floor(review.rating);
      return (
        <figure class="card card-hover flex flex-col p-6 reveal">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-0.5">
              {Array.from({ length: 5 }).map((_, i) => (
                <Icon
                  name="lucide:star"
                  class:list={[
                    'size-4',
                    i < fullStars
                      ? 'fill-gold-500 text-gold-500'
                      : 'fill-navy-100 text-navy-100',
                  ]}
                />
              ))}
            </div>
            <Icon name="lucide:quote" class="h-6 w-6 text-gold-200" />
          </div>

          <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-navy-600">
            {review.text}
          </blockquote>

          <figcaption class="mt-5 flex items-center gap-3 border-t border-navy-100 pt-4">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-navy-800 text-sm font-bold text-white">
              {review.author.charAt(0)}
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-800">{review.author}</span>
              <span class="block text-xs text-navy-400">{formatDate(review.date)}</span>
            </span>
          </figcaption>
        </figure>
      );
    })}
  </div>
</section>

{/* AggregateRating + Review schema */}
<script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />
