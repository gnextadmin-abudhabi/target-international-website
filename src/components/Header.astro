---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { contactUrl } from '../lib/urls';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-navy-100" id="site-header">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-3">
      <img 
        src={business.logo} 
        alt="Target International" 
        class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
        width="200"
        height="200"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-8 lg:flex">
      {[
        { href: '/services/', label: 'Services' },
        { href: '/areas/', label: 'Areas' },
        { href: '/about/', label: 'About' },
        { href: '/blog/', label: 'Insights' },
        { href: '/contact/', label: 'Contact' },
      ].map((item) => (
        <a
          href={item.href}
          class="group relative py-2 text-xs font-bold uppercase tracking-[0.12em] text-navy-600 transition-colors hover:text-navy-900"
        >
          {item.label}
          <span class="absolute -bottom-px left-0 h-0.5 w-0 bg-gold-500 transition-all duration-300 group-hover:w-full" />
        </a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-4">
      <a
        href={business.phoneHref}
        class="hidden items-center gap-2 text-xs font-bold uppercase tracking-[0.1em] text-navy-600 transition-colors hover:text-gold-600 sm:flex"
      >
        <Icon name="lucide:phone" class="h-3.5 w-3.5" />
        {business.phone}
      </a>

      <a
        href={contactUrl()}
        class="btn-primary hidden sm:inline-flex"
      >
        Get a Quote
      </a>

      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center text-navy-600 transition-colors hover:text-navy-900 lg:hidden"
        aria-label="Toggle menu"
        id="mobile-menu-btn"
      >
        <Icon name="lucide:menu" class="h-5 w-5" id="menu-icon-open" />
        <Icon name="lucide:x" class="hidden h-5 w-5" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="hidden border-t border-navy-100 bg-white lg:hidden" id="mobile-menu">
    <nav class="mx-auto max-w-7xl space-y-1 px-6 py-6">
      {[
        { href: '/services/', label: 'Services' },
        { href: '/areas/', label: 'Service Areas' },
        { href: '/about/', label: 'About' },
        { href: '/blog/', label: 'Insights' },
        { href: '/contact/', label: 'Contact' },
      ].map((item) => (
        <a
          href={item.href}
          class="block py-3 text-sm font-bold uppercase tracking-[0.12em] text-navy-600 transition-colors hover:text-navy-900"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4">
        <a href={business.phoneHref} class="btn-primary flex w-full items-center justify-center">
          <Icon name="lucide:phone" class="h-4 w-4" />
          {business.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  const header = document.getElementById('site-header');
  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 10) {
        header?.classList.add('shadow-md');
      } else {
        header?.classList.remove('shadow-md');
      }
    },
    { passive: true },
  );
</script>
