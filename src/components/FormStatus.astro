---
// Inline success / error message used by [data-ajax-form] forms.
import { Icon } from 'astro-icon/components';
---

<div class="form-status" data-form-status hidden role="status" aria-live="polite">
  <Icon name="lucide:circle-check" class="form-status-ok h-5 w-5 shrink-0" />
  <Icon name="lucide:circle-alert" class="form-status-err h-5 w-5 shrink-0" />
  <p data-form-status-text></p>
</div>

<style>
  .form-status {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border-radius: 0.875rem;
    padding: 0.9rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .form-status[hidden] {
    display: none;
  }

  .form-status[data-kind='success'] {
    border: 1px solid #bbe5c8;
    background: #effaf2;
    color: #166534;
  }

  .form-status[data-kind='error'] {
    border: 1px solid #f5c2c2;
    background: #fef2f2;
    color: #b42318;
  }

  .form-status[data-kind='success'] :global(.form-status-err),
  .form-status[data-kind='error'] :global(.form-status-ok) {
    display: none;
  }
</style>
