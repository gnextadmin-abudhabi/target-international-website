---
// Full-screen media viewer. Any element with [data-lightbox] inside a
// [data-lightbox-group] opens it; visible (non-hidden) items form the slideshow.
import { Icon } from 'astro-icon/components';
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const labels =
  lang === 'ar'
    ? { close: 'إغلاق', prev: 'السابق', next: 'التالي' }
    : { close: 'Close', prev: 'Previous', next: 'Next' };
---

<dialog id="lightbox" class="lightbox" aria-label="Gallery">
  <div class="lb-shell">
    <div class="lb-top">
      <span class="lb-counter" data-lb-counter dir="ltr"></span>
      <span class="lb-caption" data-lb-caption></span>
      <button type="button" class="lb-btn" data-lb-close aria-label={labels.close}>
        <Icon name="lucide:x" class="h-6 w-6" />
      </button>
    </div>

    <div class="lb-stage" data-lb-stage></div>

    <button type="button" class="lb-btn lb-nav lb-prev" data-lb-prev aria-label={labels.prev}>
      <Icon name="lucide:chevron-left" class="h-7 w-7" />
    </button>
    <button type="button" class="lb-btn lb-nav lb-next" data-lb-next aria-label={labels.next}>
      <Icon name="lucide:chevron-right" class="h-7 w-7" />
    </button>

    <div class="lb-thumbs" data-lb-thumbs></div>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 13, 22, 0.96);
    color: white;
  }

  .lightbox::backdrop {
    background: rgba(8, 13, 22, 0.9);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    animation: lbIn 0.3s ease;
  }

  @keyframes lbIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lb-shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }

  .lb-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .lb-counter {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gold-300);
    white-space: nowrap;
  }

  .lb-caption {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--color-navy-200);
  }

  .lb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .lb-btn:hover {
    background: var(--color-gold-600);
  }

  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 0 4.5rem;
    touch-action: pan-y;
  }

  .lb-stage :global(img),
  .lb-stage :global(video) {
    max-width: 100%;
    max-height: 100%;
    border-radius: 0.75rem;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    animation: lbMedia 0.35s ease;
  }

  @keyframes lbMedia {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .lb-nav {
    position: absolute;
    top: 50%;
    width: 3.25rem;
    height: 3.25rem;
    transform: translateY(-50%);
  }

  .lb-prev { inset-inline-start: 1rem; }
  .lb-next { inset-inline-end: 1rem; }

  .lb-thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 1rem 1.25rem 1.25rem;
    scrollbar-width: thin;
  }

  .lb-thumbs :global(button) {
    position: relative;
    flex: 0 0 auto;
    width: 4.5rem;
    height: 3.25rem;
    overflow: hidden;
    border-radius: 0.5rem;
    opacity: 0.45;
    outline: 2px solid transparent;
    transition: opacity 0.2s ease, outline-color 0.2s ease;
  }

  .lb-thumbs :global(button[aria-current='true']) {
    opacity: 1;
    outline-color: var(--color-gold-400);
  }

  .lb-thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .lb-stage { padding: 0 0.75rem; }
    .lb-nav { top: auto; bottom: 5.75rem; transform: none; width: 2.75rem; height: 2.75rem; }
  }
</style>

<script>
  type Item = { type: string; src: string; poster?: string; thumb: string; caption: string };

  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const stage = dlg.querySelector<HTMLElement>('[data-lb-stage]')!;
    const counter = dlg.querySelector<HTMLElement>('[data-lb-counter]')!;
    const caption = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
    const thumbs = dlg.querySelector<HTMLElement>('[data-lb-thumbs]')!;
    const rtl = document.documentElement.dir === 'rtl';
    let items: Item[] = [];
    let index = 0;

    const read = (el: HTMLElement): Item => ({
      type: el.dataset.type || 'image',
      src: el.dataset.src || '',
      poster: el.dataset.poster,
      thumb: el.dataset.thumb || '',
      caption: el.dataset.caption || '',
    });

    const render = () => {
      const it = items[index];
      stage.innerHTML = '';
      if (it.type === 'video') {
        const v = document.createElement('video');
        v.src = it.src;
        if (it.poster) v.poster = it.poster;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.muted = true;
        stage.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = it.src;
        img.alt = it.caption;
        img.decoding = 'async';
        stage.appendChild(img);
      }
      counter.textContent = `${index + 1} / ${items.length}`;
      caption.textContent = it.caption;
      thumbs.querySelectorAll('button').forEach((b, i) => {
        b.setAttribute('aria-current', String(i === index));
        if (i === index) b.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
      // preload neighbours
      [index + 1, index - 1].forEach((i) => {
        const n = items[(i + items.length) % items.length];
        if (n && n.type === 'image') new Image().src = n.src;
      });
    };

    const go = (step: number) => {
      index = (index + step + items.length) % items.length;
      render();
    };

    const open = (group: HTMLElement, start: HTMLElement) => {
      const els = Array.from(group.querySelectorAll<HTMLElement>('[data-lightbox]')).filter((el) => !el.closest('[hidden]'));
      items = els.map(read);
      index = Math.max(0, els.indexOf(start));
      thumbs.innerHTML = '';
      items.forEach((it, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.innerHTML = `<img src="${it.thumb}" alt="" loading="lazy" />${it.type === 'video' ? '<span style="position:absolute;inset:0;display:grid;place-items:center;background:rgba(0,0,0,.35);font-size:14px">▶</span>' : ''}`;
        b.addEventListener('click', () => { index = i; render(); });
        thumbs.appendChild(b);
      });
      dlg.showModal();
      document.body.style.overflow = 'hidden';
      render();
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
      const group = trigger?.closest<HTMLElement>('[data-lightbox-group]');
      if (trigger && group) {
        e.preventDefault();
        open(group, trigger);
      }
    });

    const close = () => dlg.close();
    dlg.addEventListener('close', () => {
      stage.innerHTML = '';
      document.body.style.overflow = '';
    });
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => go(-1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => go(1));
    stage.addEventListener('click', (e) => { if (e.target === stage) close(); });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(rtl ? -1 : 1);
      if (e.key === 'ArrowLeft') go(rtl ? 1 : -1);
    });

    // swipe
    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) go((dx < 0 ? 1 : -1) * (rtl ? -1 : 1));
      x0 = null;
    });
  }
</script>
