---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { contactUrl } from '../lib/urls';
import { getLang, useUi } from '../i18n';

const lang = getLang(Astro.url);

interface Props {
  label?: string;
  title: string;
  text: string;
  phoneLabel?: string;
  secondaryLabel?: string;
  compact?: boolean;
}

const { label, title, text, phoneLabel = business.phone, secondaryLabel = useUi(lang).contactUs, compact = false } = Astro.props;
---

<section class:list={[compact ? 'py-8' : 'bg-white py-20 lg:py-28']}>
  <div class:list={[!compact && 'container-x']}>
    <div class="reveal reveal-zoom relative isolate overflow-hidden rounded-[1.75rem] bg-navy-900 shadow-[var(--shadow-lift)]">
      <!-- Blueprint texture from the right half of the photo -->
      <img
        src="/images/cta-blueprint.webp"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-right opacity-30"
        width="636"
        height="768"
        loading="lazy"
      />
      <div class="bg-glow absolute inset-0 -z-10 opacity-70"></div>
      <div class="pointer-events-none absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full bg-gold-500/20 blur-3xl"></div>

      <div class="grid items-center lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <!-- Full portrait, shown at its natural proportions so nothing is cropped -->
        <div class:list={['px-6 pt-10 sm:px-10 lg:py-12 lg:ps-12 lg:pe-0', compact && 'hidden lg:block']}>
          <figure class:list={['relative mx-auto', compact ? 'max-w-[300px]' : 'max-w-[260px] sm:max-w-[320px] lg:max-w-[420px]']}>
            <span class="absolute -start-3 -top-3 h-20 w-20 rounded-ss-[1.5rem] border-s-2 border-t-2 border-gold-400" aria-hidden="true"></span>
            <span class="absolute -bottom-3 -end-3 h-20 w-20 rounded-ee-[1.5rem] border-b-2 border-e-2 border-gold-400/60" aria-hidden="true"></span>
            <img
              src="/images/cta-engineer.webp"
              alt={lang === 'ar' ? 'مهندس من تارجت إنترناشيونال' : 'Target International engineer'}
              class="relative aspect-[684/768] w-full rounded-[1.25rem] object-cover shadow-[0_24px_48px_-16px_rgba(0,0,0,0.6)] ring-1 ring-white/10"
              width="684"
              height="768"
              loading="lazy"
            />
          </figure>
        </div>

        <div class:list={['px-6 sm:px-10 lg:px-14', compact ? 'py-12 lg:py-14' : 'py-12 sm:py-14 lg:py-20']}>
          {label && <span class="section-label !text-gold-300">{label}</span>}
          <h2 class:list={['font-display leading-[1.08] text-white', label && 'mt-5', compact ? 'text-3xl sm:text-4xl' : 'text-4xl sm:text-5xl']}>
            <Fragment set:html={title} />
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-navy-200">{text}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={business.phoneHref} class="btn-gold">
              <span class="pulse-ring flex h-6 w-6 items-center justify-center rounded-full bg-white/15">
                <Icon name="lucide:phone" class="h-3.5 w-3.5" />
              </span>
              <span dir="auto">{phoneLabel}</span>
            </a>
            <a href={contactUrl(lang)} class="btn-ghost-light">
              {secondaryLabel}
              <Icon name="lucide:arrow-right" class="btn-arrow h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
