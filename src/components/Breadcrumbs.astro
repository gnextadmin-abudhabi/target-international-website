---
import { getLang, useUi, localizePath } from '../i18n';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  variant?: 'dark' | 'light';
}

const { crumbs, variant = 'dark' } = Astro.props;
const light = variant === 'light';
const lang = getLang(Astro.url);

// Prepend "Home" automatically
const allCrumbs: Crumb[] = [{ label: useUi(lang).home, href: localizePath('/', lang) }, ...crumbs];

// Build BreadcrumbList JSON-LD schema
// Google spec: the final item should omit the `item` property
const schemaItems = allCrumbs.map((crumb, index) => {
  const entry: Record<string, unknown> = {
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
  };
  // Only include `item` for crumbs that have an href (not the final one)
  if (crumb.href) {
    entry.item = new URL(crumb.href, Astro.site).href;
  }
  return entry;
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm">
    {allCrumbs.map((crumb, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && (
          <span class:list={['text-xs', light ? 'text-white/40' : 'text-navy-300']} aria-hidden="true">/</span>
        )}
        {crumb.href ? (
          <a
            href={crumb.href}
            class:list={['transition-colors', light ? 'text-white/70 hover:text-gold-300' : 'text-navy-400 hover:text-gold-600']}
          >
            {crumb.label}
          </a>
        ) : (
          <span class:list={['line-clamp-1', light ? 'font-medium text-white' : 'font-medium text-navy-800']}>{crumb.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
