---
import { Icon } from 'astro-icon/components';
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { getLang } from '../i18n';
import { getFaqs } from '../i18n/data';

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

const lang = getLang(Astro.url);
const faqs = getFaqs(lang, area, service);

const heading = lang === 'ar'
  ? (service ? `الأسئلة الشائعة حول ${service.name}` : 'الأسئلة الشائعة حول خدمات MEP')
  : (service ? `Frequently Asked Questions about ${service.name}` : 'Frequently Asked Questions about MEP Services');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="bg-white py-16 lg:py-24">
  <div class="container-x">
    <div class="reveal mx-auto max-w-3xl text-center">
      <span class="section-label justify-center">{lang === 'ar' ? 'الأسئلة الشائعة' : 'FAQs'}</span>
      <h2 class="section-title mt-5 !text-3xl sm:!text-4xl">{heading}</h2>
    </div>

    <div class="mx-auto mt-12 max-w-4xl space-y-3" data-faq-single>
      {faqs.map((faq, i) => (
        <details class="faq-item group reveal" name="faq" open={i === 0}>
          <summary class="flex items-start justify-between gap-4 p-5 text-base font-semibold text-navy-800 transition-colors hover:text-navy-900 sm:p-6 [&::-webkit-details-marker]:hidden [&::marker]:hidden">
            <span class="flex items-start gap-4">
              <span class="mt-0.5 text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
              {faq.question}
            </span>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-600 transition-all duration-300 group-open:rotate-45 group-open:bg-gold-600 group-open:text-white">
              <Icon name="lucide:plus" class="h-4 w-4" />
            </span>
          </summary>
          <div class="px-5 pb-6 ps-12 text-sm leading-relaxed text-navy-500 sm:px-6 sm:ps-[3.25rem] [&_a]:font-semibold [&_a]:text-gold-700 [&_a]:underline" set:html={faq.answer} />
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<script>
  // Single-open accordion: opening one question closes the others.
  // (The shared name attribute does this natively in newer browsers; this covers the rest.)
  document.querySelectorAll<HTMLElement>('[data-faq-single]').forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLDetailsElement>('details'));
    items.forEach((item) =>
      item.addEventListener('toggle', () => {
        if (item.open) items.forEach((other) => other !== item && (other.open = false));
      }),
    );
  });
</script>
