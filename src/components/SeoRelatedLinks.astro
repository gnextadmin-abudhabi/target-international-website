---
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { comboUrl, areaUrl } from '../lib/urls';
import { getLang } from '../i18n';
import { getServices, getArea } from '../i18n/data';

const lang = getLang(Astro.url);
const serviceTypes = getServices(lang);

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

// Other services available in this area (exclude the current service)
const otherServices = service
  ? serviceTypes.filter((s) => s.slug !== service.slug)
  : serviceTypes;

// Nearby areas resolved from slugs to full ServiceArea objects
const nearbyAreas = area.nearby
  .map((slug) => getArea(slug, lang))
  .filter((a): a is ServiceArea => a !== undefined);
---

<nav aria-label="Related pages" class="mt-12 space-y-8">
  {/* Other services in this area */}
  {otherServices.length > 0 && (
    <div>
      <h3 class="text-sm font-semibold text-navy-800">
        {lang === 'ar'
          ? (service ? `خدمات أخرى في ${area.name}` : `الخدمات في ${area.name}`)
          : (service ? `Other services in ${area.name}` : `Services in ${area.name}`)}
      </h3>
      <div class="mt-4 flex flex-wrap gap-2">
        {otherServices.map((s) => (
          <a
            href={comboUrl(area.slug, s.slug, lang)}
            class="rounded-full border border-navy-100 bg-white px-4 py-2 text-xs font-semibold text-navy-600 transition-all hover:-translate-y-0.5 hover:border-gold-300 hover:bg-gold-50 hover:text-gold-800"
          >
            {s.name}
          </a>
        ))}
      </div>
    </div>
  )}

  {/* Same service (or general area links) in nearby areas */}
  {nearbyAreas.length > 0 && (
    <div>
      <h3 class="text-sm font-semibold text-navy-800">
        {lang === 'ar'
          ? (service ? `${service.name} في المناطق المجاورة` : 'مناطق الخدمة المجاورة')
          : (service ? `${service.name} in nearby areas` : 'Nearby service areas')}
      </h3>
      <div class="mt-4 flex flex-wrap gap-2">
        {nearbyAreas.map((a) => (
          <a
            href={service ? comboUrl(a.slug, service.slug, lang) : areaUrl(a.slug, lang)}
            class="rounded-full border border-navy-100 bg-white px-4 py-2 text-xs font-semibold text-navy-600 transition-all hover:-translate-y-0.5 hover:border-gold-300 hover:bg-gold-50 hover:text-gold-800"
          >
            {a.name}
          </a>
        ))}
      </div>
    </div>
  )}
</nav>
