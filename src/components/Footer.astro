---
import { Icon } from 'astro-icon/components';
import { serviceUrl, areaUrl } from '../lib/urls';
import { getLang, useUi } from '../i18n';
import { getBusiness, getServices, getAreas } from '../i18n/data';
import Logo from './Logo.astro';

const lang = getLang(Astro.url);
const t = useUi(lang);
const business = getBusiness(lang);
const serviceTypes = getServices(lang);
const serviceAreas = getAreas(lang);
---

<footer class="relative overflow-hidden bg-navy-950 text-white">
  <div class="bg-glow pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-gold-600/10 blur-3xl" aria-hidden="true"></div>
  <div class="relative h-1 w-full bg-gradient-to-r from-gold-700 via-gold-400 to-gold-700"></div>

  <div class="container-x relative pb-10 pt-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-4">
        <Logo variant="light" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-navy-300">
          {business.tagline}. {t.footerEstablished} {business.yearEstablished}.
        </p>
        <!-- Certification badges -->
        <ul class="mt-7 flex items-center gap-4" aria-label={t.certifications}>
          {[
            { src: '/images/ISO-9001-300x300.webp', label: t.iso9001 },
            { src: '/images/ISO-45001-300x300.webp', label: t.iso45001 },
            { src: '/images/ISO-14001-300x300.webp', label: t.iso14001 },
          ].map((badge) => (
            <li>
              <img
                src={badge.src}
                alt={badge.label}
                title={badge.label}
                class="h-16 w-16 drop-shadow-[0_8px_16px_rgba(0,0,0,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:rotate-[-4deg] sm:h-20 sm:w-20"
                width="300"
                height="300"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
        <div class="mt-7 flex items-center gap-3">
          <a
            href={business.phoneHref}
            aria-label={`${t.call} ${business.phone}`}
            class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-navy-200 transition-all hover:-translate-y-1 hover:border-gold-500 hover:bg-gold-600 hover:text-white"
          >
            <Icon name="lucide:phone" class="h-4 w-4" />
          </a>
          <a
            href={`mailto:${business.email}`}
            aria-label={`${t.email} ${business.email}`}
            class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-navy-200 transition-all hover:-translate-y-1 hover:border-gold-500 hover:bg-gold-600 hover:text-white"
          >
            <Icon name="lucide:mail" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Services -->
      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold text-white">{t.footerServices}</h3>
        <div class="mt-3 h-0.5 w-8 rounded-full bg-gold-500"></div>
        <ul class="mt-6 space-y-3">
          {serviceTypes.slice(0, 6).map((service) => (
            <li>
              <a href={serviceUrl(service.slug, lang)} class="group inline-flex items-center gap-2 text-sm text-navy-300 transition-colors hover:text-white">
                <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 text-gold-500 transition-transform group-hover:translate-x-1" />
                {service.shortName}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Areas -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-semibold text-white">{t.footerAreas}</h3>
        <div class="mt-3 h-0.5 w-8 rounded-full bg-gold-500"></div>
        <ul class="mt-6 space-y-3">
          {serviceAreas.map((area) => (
            <li>
              <a href={areaUrl(area.slug, lang)} class="group inline-flex items-center gap-2 text-sm text-navy-300 transition-colors hover:text-white">
                <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 text-gold-500 transition-transform group-hover:translate-x-1" />
                {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="sm:col-span-2 lg:col-span-3">
        <h3 class="text-sm font-semibold text-white">{t.footerContact}</h3>
        <div class="mt-3 h-0.5 w-8 rounded-full bg-gold-500"></div>
        <ul class="mt-6 space-y-4">
          <li class="flex items-start gap-3">
            <Icon name="lucide:map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" />
            <span class="text-sm text-navy-300">
              {business.address.street}, {business.address.city}, {business.address.zip}
            </span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="lucide:phone" class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" />
            <a href={business.phoneHref} class="ltr text-sm text-navy-300 transition-colors hover:text-white">{business.phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="lucide:mail" class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" />
            <a href={`mailto:${business.email}`} class="break-all text-sm text-navy-300 transition-colors hover:text-white">{business.email}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="lucide:clock" class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" />
            <div class="text-sm text-navy-300">
              {business.hours.map((schedule) => (
                <p>{schedule.days}: {schedule.hours}</p>
              ))}
            </div>
          </li>
        </ul>

        <!-- Location map -->
        <div class="mt-7 overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-[0_16px_32px_-16px_rgba(0,0,0,0.6)]">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d1395.0040038948953!2d54.487850928565294!3d24.35277622041437!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMjTCsDIxJzEwLjAiTiA1NMKwMjknMTguNiJF!5e1!3m2!1sen!2sin!4v1791374474139!5m2!1sen!2sin"
            title={lang === 'ar' ? 'موقع تارجت إنترناشيونال على الخريطة' : 'Target International location map'}
            class="block aspect-[16/10] w-full border-0"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <a
          href="https://maps.app.goo.gl/JwwE8K3vqYm2g5GH8"
          target="_blank"
          rel="noopener"
          class="group mt-3 inline-flex items-center gap-2 text-sm font-semibold text-gold-400 transition-colors hover:text-white"
        >
          <Icon name="lucide:navigation" class="h-4 w-4" />
          {lang === 'ar' ? 'احصل على الاتجاهات' : 'Get Directions'}
          <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-0.5" />
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-center lg:flex-row lg:text-left">
      <p class="text-xs text-navy-400">
        &copy; {new Date().getFullYear()} {business.name}. {t.rights}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-navy-400">
        <span>{business.license}</span>
        <span class="h-1 w-1 rounded-full bg-gold-500"></span>
        <span>ISO 9001 / 14001 / 45001</span>
      </div>
      <p class="text-xs text-navy-400">
        {t.poweredBy}
        <a
          href="https://gnext.ae"
          target="_blank"
          rel="noopener"
          class="font-semibold text-gold-400 transition-colors hover:text-white"
        >gnext.ae</a>
      </p>
    </div>
  </div>
</footer>
