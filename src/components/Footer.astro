---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl } from '../lib/urls';
---

<footer class="bg-navy-900 text-white">
  <!-- Gold accent line -->
  <div class="h-1 w-full bg-gradient-to-r from-gold-600 via-gold-500 to-gold-600" />

  <div class="mx-auto max-w-7xl px-6 pb-16 pt-20 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-12">
      <!-- Brand column -->
      <div class="lg:col-span-4">
        <a href="/" class="group inline-flex items-center gap-3">
          <img 
            src={business.logoWhite} 
            alt="Target International" 
            class="h-14 w-auto brightness-110"
            width="200"
            height="200"
          />
        </a>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-navy-300">
          {business.tagline}. Licensed, insured, and locally established since {business.yearEstablished}.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a href={business.phoneHref} class="flex h-10 w-10 items-center justify-center border border-navy-600 text-navy-300 transition-colors hover:border-gold-500 hover:text-gold-400">
            <Icon name="lucide:phone" class="h-4 w-4" />
          </a>
          <a href={`mailto:${business.email}`} class="flex h-10 w-10 items-center justify-center border border-navy-600 text-navy-300 transition-colors hover:border-gold-500 hover:text-gold-400">
            <Icon name="lucide:mail" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Services -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-gold-400">Services</h3>
        <ul class="mt-6 space-y-3">
          {serviceTypes.slice(0, 6).map((service) => (
            <li>
              <a href={serviceUrl(service.slug)} class="group flex items-center gap-2 text-sm text-navy-300 transition-colors hover:text-white">
                <span class="h-px w-0 bg-gold-500 transition-all duration-300 group-hover:w-3" />
                {service.shortName}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Areas -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-gold-400">Areas</h3>
        <ul class="mt-6 space-y-3">
          {serviceAreas.map((area) => (
            <li>
              <a href={areaUrl(area.slug)} class="group flex items-center gap-2 text-sm text-navy-300 transition-colors hover:text-white">
                <span class="h-px w-0 bg-gold-500 transition-all duration-300 group-hover:w-3" />
                {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-gold-400">Contact</h3>
        <ul class="mt-6 space-y-4">
          <li class="flex items-start gap-3">
            <Icon name="lucide:map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-gold-500" />
            <span class="text-sm text-navy-300">
              {business.address.street}, {business.address.city}, {business.address.zip}
            </span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="lucide:phone" class="mt-0.5 h-4 w-4 shrink-0 text-gold-500" />
            <a href={business.phoneHref} class="text-sm text-navy-300 transition-colors hover:text-white">{business.phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="lucide:mail" class="mt-0.5 h-4 w-4 shrink-0 text-gold-500" />
            <a href={`mailto:${business.email}`} class="text-sm text-navy-300 transition-colors hover:text-white">{business.email}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="lucide:clock" class="mt-0.5 h-4 w-4 shrink-0 text-gold-500" />
            <div class="text-sm text-navy-300">
              {business.hours.map((schedule) => (
                <p>{schedule.days}: {schedule.hours}</p>
              ))}
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-navy-700 pt-8 sm:flex-row">
      <p class="text-xs text-navy-400">
        &copy; {new Date().getFullYear()} {business.name}. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs text-navy-400">
        <span>{business.license}</span>
        <span class="text-navy-600">|</span>
        <span>ISO 9001 / 14001 / 45001</span>
      </div>
    </div>
  </div>
</footer>
